<?xml version="1.0" encoding="UTF-8"?>
<!--
    SoSite — IIS 重写与安全规则（V5.0.0 专用）
    ============================================
    用法：放到站点根目录（覆盖同名文件），需已安装 IIS URL Rewrite 模块。
    前提：IIS "处理程序映射" 中已配置 PHP 的 FastCGI 处理程序（.php → php-cgi），
         否则 .php 会被当作静态文件下载，规则拦不住泄露。
    说明：install.php 在站点刚部署、尚未安装完成时需可访问，故此处不拒绝；
         安装完成上线后，可取消下面 "Deny Install" 规则的注释以加固。
-->
<configuration>
    <system.webServer>
        <!-- [PWA 2026-08-21] .webmanifest MIME 映射：IIS 默认不识别该扩展名，
             缺省会按 application/octet-stream 返回 → Chrome 拒绝识别 manifest → 安装入口不出现。
             （Apache 侧见 .htaccess AddType；Nginx 侧见 nginx-server.conf location default_type） -->
        <staticContent>
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>
        <security>
            <requestFiltering>
                <!-- 禁止访问数据库/备份文件扩展名 -->
                <fileExtensions>
                    <add fileExtension=".db" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
                <!-- 隐藏核心目录（返回 404，隐蔽性好）
                     ★ 注意：assets（主题/静态资源）与 plugins（插件资源 /plugins/{id}/assets/...）
                       必须可访问，绝不能隐藏——否则主题切换/插件样式全部 404 -->
                <hiddenSegments>
                    <add segment="app" />
                    <add segment="protected" />
                    <add segment="update" />
                    <!-- S1：data/（SQLite 分片库：business/main_index/session/桶 + extern 正文）也必须隐藏，
                         否则 IIS 下 /data/*.sqlite 可直接下载（data/web.config 内声明拦不到 /data/ 自身） -->
                    <add segment="data" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <!-- 拒绝直接访问核心目录（hiddenSegments 的二重保障，明示 403）
                     ★ 不含 plugins：插件资源 /plugins/{id}/assets/... 必须可访问 -->
                <rule name="Deny Core Directories" stopProcessing="true">
                    <match url="^(app|protected|update)(/|$)" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access Denied" />
                </rule>

                <!-- 拒绝直接访问配置文件（防止 .php 未映射时被当作静态文件下载泄露） -->
                <rule name="Deny Config" stopProcessing="true">
                    <match url="^config\.php$" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access Denied" />
                </rule>

                <!-- 主路由规则：非真实文件/目录请求交给 index.php（前端控制器） -->
                <rule name="SoSite Main Rule" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <!-- assets 是真实静态资源目录，排除以免误伤（双重保险） -->
                        <add input="{URL}" pattern="^/(assets|index\.php)" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>

                <!--
                ★ 安装完成上线后加固（取消注释启用）：禁止再次运行安装向导
                <rule name="Deny Install After Setup" stopProcessing="true">
                    <match url="^install\.php$" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access Denied" />
                </rule>
                -->
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
