<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlintHub — IIS (Windows) 禁止直接访问 protected/ 敏感目录
  ★ 审计修复 2026-08-16：protected/ 含 error.log、会话、缓存、config.php 备份（MAIL_PASS_KEY）、
    legacy 归档（旧 MySQL schema）等敏感文件。本文件仅对 IIS 生效：
      - IIS         → 本 web.config 生效（命中 hiddenSegments 返回 404）
      - Apache      → 由同目录 .htaccess 生效（本文件被忽略，无害）
      - Nginx       → 由 nginx-server.conf 的 deny 规则生效（本文件被忽略，无害）
  注意：若你的站点根目录已有根级 web.config，也可将下方 hiddenSegments 合并进去（二选一即可）。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="protected" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
