<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlintHub — IIS (Windows) 禁止直接访问数据目录
  data/ 下为 SQLite 分片库（密码哈希/会话/帖子数据）
  仅 IIS 生效；Apache 由同目录 .htaccess、Nginx 由 nginx-server.conf 兜底
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
